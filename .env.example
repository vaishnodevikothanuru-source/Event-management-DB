# ====================================================================
# EVENT SPHERE — ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Databases
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventsphere
DB_USER=postgres
DB_PASS=password123

MONGO_URI=mongodb://localhost:27017/eventsphere_mongo
REDIS_HOST=localhost
REDIS_PORT=6379

# 2. Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# 3. Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# 4. Redis & 60-Second OTP Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
OTP_EXPIRATION_SECONDS=60
MAX_OTP_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=15

# 5. OTP Providers (Twilio SMS / SMTP Email)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=auth@eventsphere.io

# 6. Service Ports
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
EVENT_SERVICE_PORT=8082
REGISTRATION_SERVICE_PORT=8083
ENGAGEMENT_SERVICE_PORT=8084
AI_SERVICE_PORT=8000
REALTIME_SERVICE_PORT=4000
FRONTEND_PORT=3000

# 7. Frontend Environment Variables
VITE_API_URL=http://localhost:8080/api
VITE_AUTH_API_URL=http://localhost:8000/api/auth
VITE_AI_URL=http://localhost:8000/api/ai

